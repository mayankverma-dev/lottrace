# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://lottrace:lottrace@localhost:5432/lottrace
# TLS is controlled by DATABASE_URL: use ?sslmode=require (or ?ssl=true) to enable it.
# Certificate verification is ON by default. Provide the provider CA if it is not
# in Node's trust store. Set only one of these:
# DB_SSL_CA_PATH=/path/to/ca.pem
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Local development only. Rejected in staging/production.
# DB_TLS_INSECURE=false

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ───
ACCESS_JWT_SECRET=<64-char-random-hex>
REFRESH_JWT_SECRET=<64-char-random-hex-different-from-above>
ARGON2_SECRET=<32-char-random-hex>

# ─── Object Storage (MinIO for dev) ────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=lottrace-dev

# ─── Email (Resend — https://resend.com) ───────────────────
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=LotTrace <onboarding@resend.dev>
DEV_EMAIL_OVERRIDE=<your_resend.com_email>@gmail.com # Receive all emails to this email for testing.
EMAIL_DRY_RUN=true # Skip Resend and only log. Accepts true|false|1|0; any other value fails startup.

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
SCAN_PWA_URL=http://localhost:3002

# ─── Seed safety ────────────────────────────────────────────
# The seed always refuses NODE_ENV=production. Local hosts run without flags.
# Remote hosts require ALLOW_DESTRUCTIVE_SEED=true plus interactive confirmation
# (or SEED_CONFIRM_REMOTE=true when there is no TTY).
ALLOW_DESTRUCTIVE_SEED=false
SEED_CONFIRM_REMOTE=false
# Optional: choose the super-admin password instead of the generated one.
# Minimum 12 characters. Existing passwords are only reset when this is set.
# SEED_SUPER_ADMIN_PASSWORD=

# ─── Stripe (test keys) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Sentry (optional in dev) ──────────────────────────────
SENTRY_DSN=
