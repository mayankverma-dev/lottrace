# Infrastructure credentials must match the root .env used by docker-compose.yml.
# Copy this file to backend/.env and replace every placeholder.

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://lottrace:<postgres-password>@127.0.0.1:5432/lottrace
# Optional runtime URL using non-owner lottrace_app role. Migrations use DATABASE_URL.
# APP_DATABASE_URL=postgresql://lottrace_app:<app-role-password>@127.0.0.1:5432/lottrace
# APP_DB_ROLE=lottrace_app
# APP_DB_PASSWORD=<local-runtime-password>

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://:<redis-password>@127.0.0.1:6379

# ─── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ───
ACCESS_JWT_SECRET=<64-char-random-hex>
REFRESH_JWT_SECRET=<64-char-random-hex-different-from-above>
REFRESH_TOKEN_ENCRYPTION_KEY=<64-char-random-hex>
ARGON2_SECRET=<32-char-random-hex>

# ─── Object Storage (MinIO for dev) ────────────────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<minio-root-user>
S3_SECRET_ACCESS_KEY=<minio-root-password>
S3_BUCKET=lottrace-dev

# ─── Email (Resend — https://resend.com) ───────────────────
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=LotTrace <onboarding@resend.dev>
DEV_EMAIL_OVERRIDE=<your_resend.com_email>@gmail.com # Receive all emails to this email for testing.
EMAIL_DRY_RUN=true # Skip Resend and only log. Accepts true|false|1|0; any other value fails startup.

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
SCAN_PWA_URL=http://localhost:3002
# Express `trust proxy` setting. Leave empty when the API is directly exposed.
# Behind a proxy, set the exact hop count or a comma-separated trusted CIDR
# list. Never set this to true; invalid values fail startup.
TRUST_PROXY=
# TRUST_PROXY=1
# TRUST_PROXY=loopback
# TRUST_PROXY=10.0.0.0/8,192.168.0.0/16

# ─── Seed safety (knex seed:run) ────────────────────────────
# Production is always refused. Local hosts run directly. Remote hosts require
# both an opt-in and confirmation; use SEED_CONFIRM_REMOTE=true in non-TTY shells.
ALLOW_DESTRUCTIVE_SEED=false
SEED_CONFIRM_REMOTE=false
# Optional: set the super-admin password (minimum 12 characters). If unset on
# first seed, a random password is generated and printed once.
# SEED_SUPER_ADMIN_PASSWORD=

# ─── Stripe (test keys) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Hash chain HMAC keyring ───────────────────────────────
# The current key signs new events and evidence. Keep HASH_CHAIN_SECRET out
# of the database and rotate it through the environment/KMS.
HASH_CHAIN_KEY_ID=dev-k1
HASH_CHAIN_SECRET=
# Optional JSON map of previous key IDs to secrets for verification after
# rotation, e.g. {"dev-k0":"<64-char hex secret>"}
HASH_CHAIN_OLD_KEYS=

# ─── Sentry (optional in dev) ──────────────────────────────
SENTRY_DSN=
