# Local infrastructure credentials for docker-compose.yml.
# Copy this file to .env and fill every blank secret before starting Compose.
# Generate each value with: openssl rand -hex 24
# Never commit .env and never reuse these values outside local development.

POSTGRES_USER=lottrace
POSTGRES_PASSWORD=
POSTGRES_DB=lottrace

REDIS_PASSWORD=

MINIO_ROOT_USER=lottrace-minio
MINIO_ROOT_PASSWORD=

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
